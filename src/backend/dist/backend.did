type Value = 
 variant {
   "bool": bool;
   float: float64;
   "int": int;
   "nat": nat;
   "null";
   "text": text;
 };
type Result = 
 record {
   hasMore: bool;
   rows: vec vec Cell;
 };
type OrderSummary = 
 record {
   city: text;
   email: text;
   fullName: text;
   lang: text;
   phone: text;
   postalCode: text;
   price: text;
   productName: text;
   quantity: nat;
   securityProfile: text;
   streetNo: text;
 };
type OrderRecord = 
 record {
   createdAt: int;
   order: OrderMessage;
   status: text;
   token: text;
 };
type OrderMessage = 
 record {
   city: text;
   contractAccepted: bool;
   email: text;
   fullName: text;
   lang: text;
   phone: text;
   postalCode: text;
   privacyAccepted: bool;
   productId: text;
   productName: text;
   quantity: nat;
   securityNotes: text;
   securityProfile: text;
   streetNo: text;
 };
type ConfirmResult = 
 variant {
   err: ConfirmError;
   ok: OrderSummary;
 };
type ConfirmError = 
 variant {
   alreadyConfirmed;
   expired;
   notFound;
 };
type Cell = 
 record {
   name: text;
   value: Value;
 };
service : {
  __orders: (ko: opt text, count: opt nat) ->
   (vec record {
          text;
          OrderRecord;
        }) query;
  confirm_order: (token: text) -> (ConfirmResult);
  execute: (qJson: text) -> (Result) query;
  schema: () -> (text) query;
  send_contact_email: (name: text, email: text, subject: text, message:
   text) -> (text);
  send_order_email: (order: OrderMessage) -> (text);
}
